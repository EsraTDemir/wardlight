{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wardlight-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/healthz"]
  },
  "d1_databases": [
    {
      "binding": "WARDLIGHT_DB",
      "database_name": "wardlight",
      "database_id": "74e52b5b-788c-4d55-88f6-b91031828ebe",
      "migrations_dir": "migrations"
    }
  ]
}
